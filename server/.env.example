DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database
ADMIN_USER=appadmin
# Optional login with access to all tables; uses ADMIN_PASSWORD.
# SUPER_USER=superadmin
# Optional table restriction for ADMIN_USER only.
# ALLOWED_TABLES=table_one,table_two
ADMIN_PASSWORD=choose_a_strong_admin_password
SESSION_SECRET=replace_with_a_long_random_secret
NODE_ENV=development
PORT=3000
DB_POOL_SIZE=2
CORS_ORIGINS=http://localhost:5173
